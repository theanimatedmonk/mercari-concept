# xAI Grok — analyze and style-on-me (server-only, never VITE_)
XAI_API_KEY=

# TypeSafe Jev — progressive search nudges (server-only, never VITE_)
# Keys: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Product catalog (server-only — set on Vercel, never VITE_)
MYNTRA_AFFILIATE_FEED_URL=

# Admitad AliExpress product feed (server-only — do not commit the URL)
ALIEXPRESS_AFFILIATE_FEED_URL=

# Admitad The Luxury Closet product feed (server-only — do not commit the URL)
LUXURYCLOSET_AFFILIATE_FEED_URL=
LUXYRE_AFFILIATE_FEED_URL=

# Amazon.in Associates + Product Advertising API 5.0
# Sign up: https://affiliate.amazon.in/ then apply for PA-API
AMAZON_MARKETPLACE=IN
AMAZON_ASSOCIATE_TAG=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_SEARCH_INDEX=Fashion

# Optional US Creators API (not required for Amazon.in)
AMAZON_CREATORS_API_KEY=
AMAZON_CREATORS_API_ENDPOINT=

CATALOG_USE_MOCK_FALLBACK=true

# Optional Vercel KV / Upstash — persist parsed dresses across serverless cold starts
KV_REST_API_URL=
KV_REST_API_TOKEN=

